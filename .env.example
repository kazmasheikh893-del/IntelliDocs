# Environment configuration template -- placeholders only.
# Copy to .env (git-ignored) and fill in. NEVER commit .env or paste keys into chat/issues.

# Google Gemini API key (create a NEW key at https://aistudio.google.com/ ; never reuse a leaked one)
GEMINI_API_KEY=your_gemini_api_key_here

# Models (verify with: python manage.py verify_gemini)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite

# Django
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(60))"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional tuning
# RAG_TOP_K=5
# RAG_MIN_SIMILARITY=0.45
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=100
# MAX_UPLOAD_SIZE_MB=10

# Production only (DEBUG=False)
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
# SECURE_SSL_REDIRECT=True
# DATA_DIR=/var/data
# REQUIRE_AUTH=True
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your_secure_password_here
